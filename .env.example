# Environment variables for development
# Copy to .env and adjust as necessary
# NEVER commit the actual .env file or hardcode secrets in source code.

PROJECT_NAME="AI Library Management System"
ENVIRONMENT="development"
DEBUG=true

# Database (SQLite file-backed for development)
# When unset or commented out, SQLite resolves to backend/library.db anchored to the backend directory.
# Explicitly providing a DATABASE_URL continues to take precedence.
# DATABASE_URL="sqlite:///./library.db"

# Security
# Generate secure keys in production: openssl rand -hex 32
JWT_SECRET_KEY="insecure-dev-secret-key-change-in-production-only"
# Dedicated signing key for study space QR passes (must be distinct from JWT_SECRET_KEY)
SPACES_QR_SECRET_KEY="insecure-dev-spaces-qr-secret-key-distinct-from-jwt"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & CSRF Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cookie Configuration
COOKIE_DOMAIN=""
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# AI Copilot & LLM Provider Configuration (Optional)
# If LLM_API_KEY is unset or empty, the Copilot automatically uses the deterministic
# local fallback engine grounded in live database records and library policies.
LLM_PROVIDER="auto"
LLM_API_KEY=""
LLM_MODEL_NAME="gemini-1.5-flash"
# LLM_API_URL="http://localhost:11434/v1"  # Optional: for local Ollama / OpenAI-compatible endpoint

# Study Space Check-In & Grace Periods
CHECKIN_WINDOW_BEFORE_MINUTES=15
CHECKIN_GRACE_PERIOD_MINUTES=15
NO_SHOW_GRACE_PERIOD_MINUTES=15
