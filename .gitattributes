# Set default line ending behavior to automatically normalize
* text=auto

# Python and backend source files
*.py text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# Frontend web assets and code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf

# Shell and batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pyc binary
